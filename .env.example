# Copy these into .env.local for local testing, and into Vercel → Settings → Environment Variables for production.
# Leave the password blank here. Paste the real SMTP password only in .env.local and in Vercel.

SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=noreply@iaudit.global
SMTP_PASS=
SMTP_FROM=noreply@iaudit.global

